{
  "name": "creacut-electron-editor",
  "version": "0.2.0-beta.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Versión beta del editor local de proyectos CREAcut",
  "author": "Ángel Peñaranda (frontend y desarrollo web) y Sebastián Suárez (pipeline)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "pack:win": "pnpm run build && pnpm run prepare:win-setup && electron-builder --win --x64 --dir",
    "dist:win": "pnpm run build && node scripts/build-windows-installer.mjs",
    "dist:win:installer": "node scripts/build-windows-installer.mjs",
    "pack:mac": "pnpm run build && pnpm run prepare:mac-setup && electron-builder --mac --dir --arm64",
    "dist:mac": "pnpm run build && pnpm run prepare:mac-setup && electron-builder --mac dmg --arm64",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:win-setup": "node scripts/prepare-backend-setup.mjs win32",
    "prepare:mac-setup": "node scripts/prepare-backend-setup.mjs darwin"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.26",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.crea.creacut",
    "afterPack": "scripts/verify-bundle.mjs",
    "productName": "CREAcut Beta",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "CREAcut-Beta-Setup-0.2.${ext}",
      "extraResources": [
        {
          "from": "python",
          "to": "backend/python",
          "filter": [
            "**/*.py",
            "requirements-runtime.txt"
          ]
        },
        {
          "from": "../creacut",
          "to": "backend/creacut",
          "filter": [
            "**/*.py"
          ]
        },
        {
          "from": "../assets",
          "to": "backend/assets",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": ".installer-build/uv.exe",
          "to": "backend-setup/uv.exe"
        },
        {
          "from": ".installer-build/manifest.json",
          "to": "backend-setup/manifest.json"
        },
        {
          "from": "resources/install-backend.ps1",
          "to": "backend-setup/install-backend.ps1"
        },
        {
          "from": "resources/install-gpu-pack.ps1",
          "to": "backend-setup/install-gpu-pack.ps1"
        },
        {
          "from": "resources/icon.png",
          "to": "icon.png"
        },
        {
          "from": "../LICENSE",
          "to": "legal/LICENSE"
        },
        {
          "from": "../AUTHORS.md",
          "to": "legal/AUTHORS.md"
        },
        {
          "from": "../THIRD_PARTY_NOTICES.md",
          "to": "legal/THIRD_PARTY_NOTICES.md"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png",
      "category": "public.app-category.video",
      "artifactName": "CREAcut-Beta-0.2-${arch}.${ext}",
      "extraResources": [
        {
          "from": "python",
          "to": "backend/python",
          "filter": [
            "**/*.py",
            "requirements-runtime.txt"
          ]
        },
        {
          "from": "../creacut",
          "to": "backend/creacut",
          "filter": [
            "**/*.py"
          ]
        },
        {
          "from": "../assets",
          "to": "backend/assets",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": ".installer-build/uv",
          "to": "backend-setup/uv"
        },
        {
          "from": ".installer-build/manifest.json",
          "to": "backend-setup/manifest.json"
        },
        {
          "from": "resources/icon.png",
          "to": "icon.png"
        },
        {
          "from": "../LICENSE",
          "to": "legal/LICENSE"
        },
        {
          "from": "../AUTHORS.md",
          "to": "legal/AUTHORS.md"
        },
        {
          "from": "../THIRD_PARTY_NOTICES.md",
          "to": "legal/THIRD_PARTY_NOTICES.md"
        }
      ]
    },
    "dmg": {
      "title": "CREAcut Beta 0.2",
      "artifactName": "CREAcut-Beta-0.2-${arch}.${ext}"
    },
    "nsis": {
      "differentialPackage": false,
      "include": "resources/installer.nsh",
      "perMachine": false,
      "allowElevation": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CREAcut Beta",
      "runAfterFinish": true
    }
  }
}
